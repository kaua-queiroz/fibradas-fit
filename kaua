<title>Fibradas</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Manrope:wght@400;500;600;700;800&display=swap">
<style>
  :root{
    --ground:#FBF7F3;
    --surface:#FFFFFF;
    --blush:#F5E0D8;
    --ink:#1F1A1C;
    --ink-2:#3B3336;
    --muted:#8A7C7E;
    --line:#EFE5DF;
    --line-2:#E5D8D0;
    --pink:#FF2E93;
    --pink-2:#E51F81;
    --lime:#E9FF5F;
    --shadow:0 20px 40px -24px rgba(38,10,25,.22);
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{margin:0;padding:0;overflow-x:hidden}
  body{
    background:var(--ground);
    color:var(--ink);
    font-family:'Manrope',system-ui,-apple-system,sans-serif;
    -webkit-font-smoothing:antialiased;
    line-height:1.5;
    font-size:15px;
  }
  a{color:inherit;text-decoration:none}
  img{max-width:100%;display:block}
  button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;padding:0}

  /* ---------- HEADER ---------- */
  .top-strip{
    background:var(--ink);color:#fff;
    text-align:center;padding:8px 16px;
    font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;font-weight:600;
  }
  .top-strip b{color:var(--lime)}
  .coupon-bar{
    background:linear-gradient(90deg, var(--pink) 0%, #FF5AAE 100%);
    color:#fff;text-align:center;
    padding:9px 16px;font-size:12.5px;font-weight:700;letter-spacing:.02em;
  }
  .coupon-bar b{background:var(--lime);color:var(--ink);padding:2px 8px;border-radius:6px;margin:0 2px;font-weight:800}

  /* ---------- WhatsApp float ---------- */
  .wa-float{
    position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom));z-index:50;
    background:#25D366;color:#fff;
    width:56px;height:56px;border-radius:50%;
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 10px 30px rgba(37,211,102,.5);
    animation:pulse 2.4s ease-in-out infinite;
  }
  .wa-float svg{width:30px;height:30px}
  .wa-float:hover{background:#1EBE5D;transform:scale(1.06)}
  @keyframes pulse{
    0%,100%{box-shadow:0 10px 30px rgba(37,211,102,.5)}
    50%{box-shadow:0 10px 40px rgba(37,211,102,.75), 0 0 0 8px rgba(37,211,102,.15)}
  }

  /* ---------- Promises section ---------- */
  .promises{
    background:var(--surface);
    padding:44px 20px;margin-top:36px;
    border-top:1px solid var(--line);border-bottom:1px solid var(--line);
  }
  .promises .head{max-width:1180px;margin:0 auto 26px;text-align:center}
  .promises h2{
    font-family:'Fraunces',serif;font-weight:500;
    font-size:clamp(26px,5vw,38px);letter-spacing:-.02em;margin:0 0 8px;
  }
  .promises .sub{color:var(--muted);font-size:14.5px;margin:0}
  .promises-grid{
    max-width:1180px;margin:0 auto;
    display:grid;grid-template-columns:1fr 1fr;gap:14px;
  }
  .promise{
    background:var(--ground);border-radius:16px;padding:20px;
    border:1px solid var(--line);
  }
  .promise .ic{
    width:38px;height:38px;border-radius:50%;
    background:var(--lime);
    display:flex;align-items:center;justify-content:center;
    margin-bottom:12px;font-size:18px;
  }
  .promise h4{font-family:'Fraunces',serif;font-weight:600;font-size:17px;margin:0 0 4px;letter-spacing:-.01em}
  .promise p{font-size:13.5px;color:var(--ink-2);margin:0;line-height:1.45}
  @media (min-width:720px){ .promises-grid{grid-template-columns:repeat(4,1fr)} }

  /* ---------- Testimonials ---------- */
  .testis{
    padding:44px 20px;
    background:var(--ground);
  }
  .testis .head{max-width:1180px;margin:0 auto 24px;text-align:center}
  .testis h2{
    font-family:'Fraunces',serif;font-weight:500;
    font-size:clamp(26px,5vw,38px);letter-spacing:-.02em;margin:0 0 8px;
  }
  .testis .sub{color:var(--muted);font-size:14.5px;margin:0}
  .testis-grid{
    max-width:900px;margin:0 auto;
    display:grid;grid-template-columns:1fr;gap:14px;
  }
  .testi{
    background:var(--surface);border-radius:16px;padding:22px;
    border:1px solid var(--line);
    position:relative;
  }
  .testi .stars{color:var(--pink);letter-spacing:.1em;font-size:14px;margin-bottom:10px}
  .testi .txt{
    font-family:'Fraunces',serif;font-size:17px;line-height:1.45;color:var(--ink);
    margin:0 0 14px;font-style:italic;
  }
  .testi .who{
    display:flex;align-items:center;gap:10px;
    padding-top:12px;border-top:1px dashed var(--line-2);
  }
  .testi .who .av{
    width:36px;height:36px;border-radius:50%;
    background:linear-gradient(135deg,var(--blush),var(--pink));
    color:#fff;display:flex;align-items:center;justify-content:center;
    font-weight:800;font-size:14px;
  }
  .testi .who .n{font-weight:800;font-size:13.5px}
  .testi .who .c{font-size:12px;color:var(--muted)}
  @media (min-width:720px){ .testis-grid{grid-template-columns:repeat(2,1fr)} }

  /* ---------- Founder ---------- */
  .founder{
    max-width:1180px;margin:0 auto;padding:44px 20px;
    display:grid;grid-template-columns:1fr;gap:24px;align-items:center;
  }
  .founder-img{
    aspect-ratio:4/5;
    background:linear-gradient(135deg,var(--blush) 0%, var(--blush-2) 100%);
    border-radius:20px;overflow:hidden;
    display:flex;align-items:center;justify-content:center;
    color:var(--muted);font-size:14px;text-align:center;padding:20px;
    max-width:420px;margin:0 auto;width:100%;
  }
  .founder-img img{width:100%;height:100%;object-fit:cover}
  .founder-copy h2{
    font-family:'Fraunces',serif;font-weight:500;
    font-size:clamp(24px,5vw,34px);letter-spacing:-.02em;margin:8px 0 12px;text-wrap:balance;
  }
  .founder-copy h2 em{color:var(--pink);font-style:italic}
  .founder-copy p{font-size:15.5px;color:var(--ink-2);margin:0 0 12px;max-width:52ch}
  .founder-copy .sig{
    display:flex;align-items:center;gap:12px;margin-top:18px;
    padding-top:16px;border-top:1px dashed var(--line-2);
  }
  .founder-copy .sig .nm{font-family:'Fraunces',serif;font-weight:600;font-size:18px;letter-spacing:-.01em}
  .founder-copy .sig .rl{font-size:12px;color:var(--muted);letter-spacing:.12em;text-transform:uppercase;font-weight:700;margin-top:2px}
  @media (min-width:820px){ .founder{grid-template-columns:.9fr 1.1fr;gap:56px;padding:64px 20px} }

  /* Trust badges */
  .trust{
    max-width:1180px;margin:0 auto;padding:28px 20px 0;
    display:grid;grid-template-columns:repeat(2,1fr);gap:10px;
  }
  .trust .tb{
    background:var(--surface);border:1px solid var(--line);border-radius:14px;
    padding:16px 14px;display:flex;align-items:center;gap:12px;
    transition:border-color .2s ease;
  }
  .trust .tb:hover{border-color:var(--pink)}
  .trust .tb .ic{
    width:40px;height:40px;flex:0 0 auto;
    background:#FDF0F7;color:var(--pink);border-radius:50%;
    display:flex;align-items:center;justify-content:center;
  }
  .trust .tb .ic svg{width:20px;height:20px}
  .trust .tb .t{font-weight:800;font-size:13px;line-height:1.15;color:var(--ink)}
  .trust .tb .s{font-size:11.5px;color:var(--muted);margin-top:2px}
  @media (min-width:720px){ .trust{grid-template-columns:repeat(4,1fr);padding:36px 20px 0} }
  header.nav{
    position:sticky;top:0;z-index:40;
    background:rgba(251,247,243,.94);
    backdrop-filter:blur(12px);
    -webkit-backdrop-filter:blur(12px);
    border-bottom:1px solid var(--line);
  }
  .nav-inner{
    max-width:1180px;margin:0 auto;
    display:flex;align-items:center;justify-content:space-between;
    padding:12px 18px;gap:16px;
  }
  .logo{display:flex;align-items:center;gap:10px}
  .logo img{width:38px;height:38px;border-radius:50%}
  .logo .w{font-family:'Fraunces',serif;font-weight:700;font-size:22px;letter-spacing:-.02em}
  .logo .w em{font-style:normal;color:var(--pink)}
  .cart-btn{
    display:flex;align-items:center;gap:8px;
    background:var(--ink);color:#fff;
    padding:9px 14px;border-radius:999px;
    font-weight:700;font-size:12.5px;letter-spacing:.02em;
  }
  .cart-btn:hover{background:var(--pink)}
  .cart-btn svg{width:16px;height:16px}
  .cart-btn .count{
    background:var(--lime);color:var(--ink);
    min-width:20px;height:20px;border-radius:10px;
    display:inline-flex;align-items:center;justify-content:center;
    font-size:11.5px;font-weight:800;padding:0 6px;
  }

  /* Category pills row - scrollable on mobile */
  .pills{
    background:var(--ground);
    border-bottom:1px solid var(--line);
    position:sticky;top:62px;z-index:30;
  }
  .pills-inner{
    max-width:1180px;margin:0 auto;
    display:flex;gap:8px;padding:10px 18px;
    overflow-x:auto;scrollbar-width:none;
  }
  .pills-inner::-webkit-scrollbar{display:none}
  .pills button{
    flex:0 0 auto;
    padding:8px 14px;border-radius:999px;
    font-size:12.5px;font-weight:700;letter-spacing:.02em;
    background:var(--surface);color:var(--ink-2);
    border:1px solid var(--line);
    white-space:nowrap;
  }
  .pills button.active{background:var(--ink);color:#fff;border-color:var(--ink)}

  /* ---------- HERO ---------- */
  .hero{
    max-width:1180px;margin:0 auto;
    padding:28px 20px 24px;
    display:grid;grid-template-columns:1fr;gap:24px;
    align-items:center;
  }
  .hero-copy{text-align:center}
  .hero-img{
    position:relative;
    border-radius:22px;overflow:hidden;
    aspect-ratio:4/5;
    background:linear-gradient(135deg,#FFE4EF 0%,#F5DFD8 100%);
    box-shadow:var(--shadow);
    max-width:520px;margin:0 auto;width:100%;
  }
  .hero-img img{width:100%;height:100%;object-fit:cover}
  .hero-img .badge{
    position:absolute;top:16px;left:16px;
    background:var(--lime);color:var(--ink);
    padding:7px 12px;border-radius:999px;
    font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;
  }
  .hero-img .quote{
    position:absolute;left:16px;right:16px;bottom:16px;
    background:rgba(31,26,28,.75);color:#fff;
    padding:12px 14px;border-radius:14px;
    backdrop-filter:blur(6px);
    font-size:13px;line-height:1.4;
  }
  .hero-img .quote b{color:var(--lime)}
  @media (min-width:820px){
    .hero{grid-template-columns:1fr 1fr;gap:56px;padding:56px 20px 40px;text-align:left}
    .hero-copy{text-align:left}
    .hero-copy .hero-ctas{justify-content:flex-start}
    .hero-img{max-width:none;order:2}
  }
  .eyebrow{
    display:inline-flex;align-items:center;gap:8px;
    text-transform:uppercase;letter-spacing:.22em;font-size:10.5px;
    font-weight:700;color:var(--pink);
    margin-bottom:16px;
  }
  .eyebrow::before{content:"";width:22px;height:2px;background:var(--pink);border-radius:2px}
  .hero-copy .eyebrow::after{content:"";width:22px;height:2px;background:var(--pink);border-radius:2px}
  h1.big{
    font-family:'Fraunces',serif;font-weight:400;
    font-size:clamp(34px,8vw,64px);line-height:1;
    letter-spacing:-.02em;margin:0 0 18px;
    text-wrap:balance;
  }
  h1.big em{font-style:italic;color:var(--pink)}
  .lede{
    font-size:16px;max-width:52ch;color:var(--ink-2);
    margin:0 auto 26px;text-wrap:balance;
  }
  .hero-ctas{display:flex;gap:10px;flex-wrap:wrap;justify-content:center}
  .btn{
    display:inline-flex;align-items:center;gap:8px;
    padding:14px 22px;border-radius:999px;font-weight:700;font-size:13.5px;
    transition:transform .15s ease;
  }
  .btn:hover{transform:translateY(-1px)}
  .btn-primary{background:var(--pink);color:#fff}
  .btn-primary:hover{background:var(--pink-2)}
  .btn-ghost{background:transparent;color:var(--ink);border:1.5px solid var(--ink)}
  .btn-ghost:hover{background:var(--ink);color:#fff}

  /* Small marquee-like strip */
  .strip{
    background:var(--surface);
    padding:14px 0;margin-top:26px;
    border-top:1px solid var(--line);border-bottom:1px solid var(--line);
    overflow:hidden;
  }
  .strip{padding:14px 0;display:flex}
  .strip .row{
    display:flex;gap:32px;align-items:center;
    white-space:nowrap;flex:0 0 auto;
    animation:slide 28s linear infinite;
    font-family:'Fraunces',serif;font-size:17px;font-weight:500;color:var(--ink-2);
    padding-right:32px;
  }
  .strip .row span{display:inline-flex;align-items:center;gap:14px}
  .strip .row .dot{width:5px;height:5px;border-radius:50%;background:var(--pink);flex:0 0 5px}
  @keyframes slide{from{transform:translateX(0)}to{transform:translateX(-100%)}}

  /* ---------- LOJA ---------- */
  .section-head{
    max-width:1180px;margin:40px auto 14px;padding:0 20px;
    display:flex;align-items:baseline;justify-content:space-between;gap:12px;
  }
  .section-head h2{
    font-family:'Fraunces',serif;font-weight:500;
    font-size:clamp(26px,5vw,38px);letter-spacing:-.02em;margin:0;
  }
  .section-head .count{color:var(--muted);font-size:13px;font-weight:600}

  .grid{
    max-width:1180px;margin:0 auto;padding:0 12px 40px;
    display:grid;grid-template-columns:repeat(2,1fr);gap:12px;
  }
  .card{
    background:var(--surface);border-radius:16px;overflow:hidden;
    display:flex;flex-direction:column;
    transition:transform .2s ease, box-shadow .2s ease;
    border:1px solid var(--line);
  }
  .card:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
  .thumb{
    position:relative;aspect-ratio:3/4;overflow:hidden;background:#F5EFE9;
  }
  .thumb img{
    width:100%;height:100%;object-fit:cover;
    transition:transform .5s ease;
  }
  .card:hover .thumb img{transform:scale(1.03)}
  .tag{
    position:absolute;top:10px;left:10px;
    background:var(--lime);color:var(--ink);
    font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;
    padding:5px 9px;border-radius:999px;
  }
  .tag.dark{background:var(--ink);color:#fff}
  .heart{
    position:absolute;top:10px;right:10px;
    width:32px;height:32px;border-radius:50%;
    background:rgba(255,255,255,.9);backdrop-filter:blur(4px);
    display:flex;align-items:center;justify-content:center;
    font-size:15px;color:var(--ink);
  }
  .heart.on{color:var(--pink)}
  .body{padding:12px 12px 14px;display:flex;flex-direction:column;gap:6px}
  .cat-label{
    font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);
  }
  h3.name{margin:0;font-family:'Fraunces',serif;font-weight:500;font-size:16.5px;letter-spacing:-.01em;line-height:1.15}
  .bul{color:var(--muted);font-size:12px;line-height:1.4;margin:2px 0 4px}
  .price-row{display:flex;align-items:center;justify-content:space-between;gap:6px;margin-top:4px}
  .price{font-size:16.5px;font-weight:800;font-variant-numeric:tabular-nums}
  .price small{font-weight:600;color:var(--muted);font-size:11px;display:block;margin-top:1px}
  .add{
    background:var(--ink);color:#fff;
    width:36px;height:36px;border-radius:50%;
    display:flex;align-items:center;justify-content:center;
    font-size:20px;font-weight:600;line-height:0;
  }
  .add:hover{background:var(--pink)}

  /* ---------- ABOUT ---------- */
  .about{
    max-width:1180px;margin:20px auto 0;padding:40px 20px;
    border-top:1px solid var(--line);
    text-align:center;
  }
  .about h2{
    font-family:'Fraunces',serif;font-weight:500;
    font-size:clamp(26px,5vw,40px);letter-spacing:-.02em;
    margin:10px 0 14px;text-wrap:balance;
  }
  .about h2 em{font-style:italic;color:var(--pink)}
  .about p{
    font-size:15px;color:var(--ink-2);max-width:56ch;
    margin:0 auto 12px;
  }
  .about .sig{
    margin-top:22px;padding-top:22px;border-top:1px dashed var(--line-2);
    font-family:'Fraunces',serif;font-style:italic;font-size:18px;
    color:var(--ink);
  }
  .about .sig::before{content:"“";color:var(--pink);font-size:26px;margin-right:2px;vertical-align:-4px}
  .about .sig::after{content:"”";color:var(--pink);font-size:26px;margin-left:2px;vertical-align:-4px}

  /* ---------- FOOTER ---------- */
  footer{
    background:var(--ink);color:#F1E9E5;margin-top:36px;padding:40px 20px 28px;
  }
  .foot-in{max-width:1180px;margin:0 auto}
  .foot-in .brand{font-family:'Fraunces',serif;font-size:26px;margin:0 0 6px;letter-spacing:-.01em;color:#fff}
  .foot-in .brand em{color:var(--pink);font-style:normal}
  .foot-in p{font-size:14px;color:#C9BEB9;margin:6px 0;max-width:52ch}
  .foot-links{display:flex;flex-wrap:wrap;gap:6px 22px;margin:18px 0 0}
  .foot-links a{font-size:13px;color:#C9BEB9;padding:6px 0}
  .foot-links a:hover{color:var(--lime)}
  .fine{
    max-width:1180px;margin:22px auto 0;padding-top:18px;
    border-top:1px solid rgba(255,255,255,.12);
    display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;
    font-size:12px;color:#8F827D;
  }

  /* ---------- CART DRAWER ---------- */
  .backdrop{
    position:fixed;inset:0;background:rgba(20,10,15,.5);z-index:60;
    opacity:0;pointer-events:none;transition:opacity .25s ease;
  }
  .drawer{
    position:fixed;top:0;right:0;bottom:0;width:min(420px,100%);
    background:var(--ground);z-index:70;
    transform:translateX(100%);transition:transform .3s ease;
    display:flex;flex-direction:column;
  }
  body.cart-open .backdrop{opacity:1;pointer-events:auto}
  body.cart-open .drawer{transform:translateX(0)}
  .drawer .hd{
    padding:16px 18px;border-bottom:1px solid var(--line);
    display:flex;align-items:center;justify-content:space-between;
    background:var(--surface);
  }
  .drawer .hd h3{font-family:'Fraunces',serif;font-weight:500;font-size:22px;margin:0;letter-spacing:-.01em}
  .drawer .close{
    width:36px;height:36px;border-radius:50%;
    background:var(--ground);border:1px solid var(--line);
    display:flex;align-items:center;justify-content:center;font-size:20px;
  }
  .items{flex:1;overflow:auto;padding:8px 18px}
  .empty{padding:40px 20px;text-align:center;color:var(--muted)}
  .empty .em{font-family:'Fraunces',serif;font-size:22px;color:var(--ink);margin-bottom:6px}
  .ci{display:flex;gap:12px;padding:14px 0;border-bottom:1px solid var(--line)}
  .ci .thumb-mini{width:64px;height:80px;border-radius:10px;flex:0 0 auto;overflow:hidden;background:#eee}
  .ci .thumb-mini img{width:100%;height:100%;object-fit:cover}
  .ci .info{flex:1;min-width:0}
  .ci .info h4{margin:0;font-family:'Fraunces',serif;font-size:15.5px;font-weight:600}
  .ci .info .sz{font-size:12px;color:var(--muted);margin-top:2px}
  .ci .info .sz b{color:var(--ink)}
  .size-pick{margin-top:6px;display:flex;gap:4px;flex-wrap:wrap}
  .size-pick button{padding:3px 7px;border-radius:6px;border:1px solid var(--line);background:var(--surface);font-size:11px;font-weight:700}
  .size-pick button.on{background:var(--ink);color:#fff;border-color:var(--ink)}
  .ci .right{display:flex;flex-direction:column;align-items:flex-end;justify-content:space-between;gap:6px}
  .ci .p{font-weight:800;font-variant-numeric:tabular-nums;font-size:14px}
  .qty{display:inline-flex;align-items:center;border:1px solid var(--line);border-radius:999px;overflow:hidden;background:var(--surface)}
  .qty button{width:26px;height:26px;font-size:14px;font-weight:800}
  .qty span{min-width:22px;text-align:center;font-size:13px;font-weight:700;font-variant-numeric:tabular-nums}
  .rm{color:var(--muted);font-size:11px;font-weight:600;text-decoration:underline}
  .drawer .ft{padding:16px 18px calc(16px + env(safe-area-inset-bottom));border-top:1px solid var(--line);background:var(--surface)}
  .totals{display:flex;justify-content:space-between;font-size:13.5px;color:var(--muted);margin-bottom:4px}
