  function addToCart(id){
    const idx = cart.findIndex(c=>c.id===id && !c.size);
    if (idx>=0) cart[idx].qty += 1;
    else cart.push({id, qty:1, size:null});
    saveCart(); updateCart(); openCart();
  }
  function changeQty(idx, d){
    cart[idx].qty += d;
    if (cart[idx].qty<=0) cart.splice(idx,1);
    saveCart(); updateCart();
  }
  function setSize(idx, s){ cart[idx].size = s; saveCart(); updateCart(); }
  function removeItem(idx){ cart.splice(idx,1); saveCart(); updateCart(); }

  function updateCart(){
    const cn = cart.reduce((s,i)=>s+i.qty,0);
    document.getElementById("cart-count").textContent = cn;
    const pcn = document.getElementById("pdp-cart-count"); if(pcn) pcn.textContent = cn;
    const wrap = document.getElementById("items");
    if (!cart.length){
      wrap.innerHTML = `<div class="empty"><div class="em">Sua sacola tá vazia.</div>Escolha suas peças e a gente combina frete e forma de pagamento no WhatsApp.</div>`;
    } else {
      wrap.innerHTML = cart.map((c,i)=>{
        const p = findProd(c.id); if(!p) return "";
        return `<div class="ci">
          <div class="thumb-mini"><img src="${p.imgs[0]}" alt=""></div>
          <div class="info">
            <h4>${p.name}</h4>
            <div class="sz">Tamanho ${c.size?`<b>${c.size}</b>`:'<span style="color:var(--pink);font-weight:700">selecione ↓</span>'}</div>
            <div class="size-pick">${SIZES.map(s=>`<button class="${c.size===s?'on':''}" onclick="setSize(${i},'${s}')">${s}</button>`).join("")}</div>
          </div>
          <div class="right">
            <div class="p">${fmt(p.price*c.qty)}</div>
            <div class="qty">
              <button onclick="changeQty(${i},-1)" aria-label="Diminuir">−</button>
              <span>${c.qty}</span>
              <button onclick="changeQty(${i},1)" aria-label="Aumentar">+</button>
            </div>
            <button class="rm" onclick="removeItem(${i})">remover</button>
          </div>
        </div>`;
      }).join("");
    }
    const sub = cart.reduce((s,c)=>{ const p=findProd(c.id); return s+(p?p.price*c.qty:0); },0);
    document.getElementById("subt").textContent = fmt(sub);
    document.getElementById("tot").textContent  = fmt(sub);
    document.getElementById("fret").textContent = sub>=25000 ? "grátis" : "a combinar";
  }

  function openCart(){ document.body.classList.add("cart-open"); }
  function closeCart(){ document.body.classList.remove("cart-open"); }

  function checkoutWA(){
    if (!cart.length){ alert("Sua sacola está vazia."); return; }
    const missingSize = cart.some(c=>!c.size);
    let lines = ["Oi Fibradas! 💕 Quero fechar meu pedido:",""];
    cart.forEach(c=>{
      const p = findProd(c.id); if(!p) return;
      lines.push(`• *${p.name}*`);
      lines.push(`  Tamanho: ${c.size||'a combinar'} · Qtd: ${c.qty} · ${fmt(p.price*c.qty)}`);
    });
    const sub = cart.reduce((s,c)=>{ const p=findProd(c.id); return s+(p?p.price*c.qty:0); },0);
    lines.push("");
    lines.push(`*Total: ${fmt(sub)}*`);
    if (missingSize) lines.push("", "Ainda preciso confirmar tamanho(s).");
    lines.push("", "Pode me passar o valor do frete e forma de pagamento?");
    const url = "https://wa.me/"+WHATSAPP+"?text="+encodeURIComponent(lines.join("\n"));
    window.location.href = url;
  }

  // ---------- PDP ----------
  let pdpState = { id:null, size:null };

  function openPDP(id){
    const p = findProd(id); if(!p) return;
    pdpState = { id, size:null };
    const body = document.getElementById("pdp-body");
    const others = PRODUCTS.filter(x => x.cat===p.cat && x.id!==p.id).slice(0,6);
    body.innerHTML = `
      <div class="pdp-inner">
        <div>
          <div class="gal-wrap">
            <div class="gal" id="gal">
              ${p.imgs.map(src => `<div class="slide"><img src="${src}" alt="${p.name}"></div>`).join("")}
            </div>
            ${p.imgs.length>1 ? `
              <button class="gal-hint l" onclick="galScroll(-1)" aria-label="Foto anterior"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg></button>
              <button class="gal-hint r" onclick="galScroll(1)" aria-label="Próxima foto"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></button>
              <div class="gal-counter" id="galCounter">1 / ${p.imgs.length}</div>
            `:""}
          </div>
          ${p.imgs.length>1 ? `<div class="gal-thumbs" id="galThumbs">
            ${p.imgs.map((src,i)=>`<button class="${i===0?'on':''}" data-i="${i}" aria-label="Foto ${i+1}"><img src="${src}" alt=""></button>`).join("")}
          </div>`:""}
        </div>
        <div class="pdp-info">
          <div class="cat-label">${p.cat}${p.tag?` · ${p.tag}`:""}</div>
          <h2>${p.name}</h2>
          <div class="pdp-price">
            <span class="big">${fmt(p.price)}</span>
            <span class="p3">ou <b>3x de ${fmt(Math.round(p.price/3))}</b> sem juros</span>
          </div>
          <div style="background:var(--lime);color:var(--ink);padding:10px 14px;border-radius:12px;font-weight:800;font-size:14px;margin-bottom:18px;display:inline-block">
            💸 ${fmt(Math.round(p.price*0.95))} pagando no Pix (5% off)
          </div>
          <p class="pdp-story">${p.desc}</p>
          <ul class="pdp-benefits">
            ${p.bullets.map(b=>`<li>${b}</li>`).join("")}
          </ul>
          <div class="pdp-block-title">Escolha o tamanho</div>
          <div class="pdp-sizes" id="pdpSizes">
            ${SIZES.map(s=>`<button data-s="${s}">${s}</button>`).join("")}
          </div>
          <div class="pdp-guide">Está entre dois tamanhos? Pega o maior — <a href="#" onclick="return false">ver guia de medidas</a>.</div>
        </div>
        ${(function(){
          const rel = TESTIS.filter(t=>t.productId===p.id);
          if (!rel.length) return "";
          const avg = (rel.reduce((s,t)=>s+t.stars,0)/rel.length).toFixed(1);
          return `<div class="pdp-testis">
            <div class="pdp-testis-head">
              <h4>O que dizem sobre esta peça</h4>
              <div class="rating"><span class="s">${"★".repeat(Math.round(avg))}${"☆".repeat(5-Math.round(avg))}</span> <b>${avg.replace(".",",")}</b> · ${rel.length} avaliaç${rel.length===1?"ão":"ões"}</div>
            </div>
            <div class="pdp-testis-grid">
              ${rel.slice(0,6).map(testiHTML).join("")}
            </div>
          </div>`;
        })()}
        <div class="pdp-more">
          <h4>Você também vai amar</h4>
          <div class="rail">
            ${others.map(o=>`
              <div class="rc" onclick="openPDP('${o.id}')">
                <div class="t"><img src="${o.imgs[0]}" alt="${o.name}"></div>
                <div class="b">
                  <div class="cn">${o.name}</div>
                  <div class="cp">${fmt(o.price)}</div>
                </div>
              </div>`).join("")}
          </div>
        </div>
      </div>`;

    // Sticky bottom CTA
    const cta = document.getElementById("pdp-cta");
    cta.innerHTML = `
      <div class="pinfo">
        <div class="n">${p.name}</div>
        <div class="pp">${fmt(p.price)}</div>
      </div>
      <button class="go" onclick="addPDPToCart()">
        Adicionar à sacola
      </button>`;

    // Size selection
    document.getElementById("pdpSizes").addEventListener("click", e=>{
      if(e.target.tagName!=="BUTTON") return;
      document.querySelectorAll("#pdpSizes button").forEach(b=>b.classList.remove("on"));
      e.target.classList.add("on");
      pdpState.size = e.target.dataset.s;
    });

    // Gallery: thumbnails + counter + swipe sync
    const gal = document.getElementById("gal");
    if (p.imgs.length>1){
      const thumbs = document.querySelectorAll("#galThumbs button");
      const counter = document.getElementById("galCounter");
      gal.addEventListener("scroll", ()=>{
        const idx = Math.round(gal.scrollLeft / gal.clientWidth);
        thumbs.forEach((b,i)=>b.classList.toggle("on", i===idx));
        if (counter) counter.textContent = (idx+1)+" / "+p.imgs.length;
      });
      thumbs.forEach(b=>{
        b.addEventListener("click", ()=>{
          const i = +b.dataset.i;
          gal.scrollTo({ left: i*gal.clientWidth, behavior:"smooth" });
        });
      });
    }

    document.body.classList.add("pdp-open");
    document.getElementById("pdp").setAttribute("aria-hidden","false");
    document.getElementById("pdp-body").scrollTop = 0;
  }

  function galScroll(dir){
    const gal = document.getElementById("gal"); if(!gal) return;
    gal.scrollBy({ left: dir*gal.clientWidth, behavior:"smooth" });
  }

  function closePDP(){
    document.body.classList.remove("pdp-open");
    document.getElementById("pdp").setAttribute("aria-hidden","true");
  }

  function addPDPToCart(){
    if(!pdpState.id) return;
    if(!pdpState.size){
      // pulse the size selector
      const s = document.getElementById("pdpSizes");
      s.scrollIntoView({behavior:"smooth", block:"center"});
      s.animate([
        {transform:"scale(1)", boxShadow:"0 0 0 0 rgba(255,46,147,0)"},
        {transform:"scale(1.02)", boxShadow:"0 0 0 8px rgba(255,46,147,.15)"},
        {transform:"scale(1)", boxShadow:"0 0 0 0 rgba(255,46,147,0)"}
      ], {duration:600, iterations:2});
      return;
    }
    // add with size
    const idx = cart.findIndex(c=>c.id===pdpState.id && c.size===pdpState.size);
    if(idx>=0) cart[idx].qty += 1;
    else cart.push({id:pdpState.id, qty:1, size:pdpState.size});
    saveCart(); updateCart();
    // Feedback: brief close + open cart
    closePDP();
    setTimeout(openCart, 220);
  }

  document.getElementById("pills").addEventListener("click", e=>{
    if (e.target.tagName!=="BUTTON") return;
    document.querySelectorAll("#pills button").forEach(b=>b.classList.remove("active"));
    e.target.classList.add("active");
    renderGrid(e.target.dataset.cat);
    document.getElementById("loja").scrollIntoView({behavior:"smooth", block:"start"});
  });

  renderGrid();
  renderTestis();
  updateCart();
</script>
